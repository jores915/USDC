{
  "name": "usdc-linea-deployment",
  "version": "1.0.0",
  "description": "USDC stablecoin deployment on Ethereum Linea network",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "compile": "hardhat compile",
    "deploy:linea-testnet": "hardhat run scripts/deploy.js --network linea-testnet",
    "deploy:linea-mainnet": "hardhat run scripts/deploy.js --network linea-mainnet",
    "verify:testnet": "hardhat verify --network linea-testnet",
    "verify:mainnet": "hardhat verify --network linea-mainnet",
    "gas-report": "REPORT_GAS=true hardhat test"
  },
  "keywords": [
    "usdc",
    "stablecoin",
    "ethereum",
    "linea",
    "blockchain"
  ],
  "author": "jores915",
  "license": "MIT",
  "devDependencies": {
    "@nomiclabs/hardhat-waffle": "^2.0.6",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-etherscan": "^3.1.7",
    "@openzeppelin/hardhat-upgrades": "^2.0.0",
    "chai": "^4.3.7",
    "ethereum-waffle": "^4.0.10",
    "ethers": "^6.7.1",
    "hardhat": "^2.17.0",
    "hardhat-gas-reporter": "^1.0.9",
    "dotenv": "^16.3.1"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "@openzeppelin/contracts-upgradeable": "^5.0.0"
  }
}
